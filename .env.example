# AI Coloring Book Studio configuration. Copy to .env. Placeholder values only; never commit real secrets.

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8790
PUBLIC_URL=http://localhost:8790
LOG_LEVEL=info
# Where object storage (images, PDFs, ZIPs) and the embedded database live.
DATA_DIR=.data
# Behind HTTPS (production) these should be true.
SECURE_COOKIES=false
TRUST_PROXY=false
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Database -----------------------------------------------------------
# Empty = embedded PostgreSQL (PGlite) stored under DATA_DIR/pglite. Fine for one process.
# For production or separate worker processes use a PostgreSQL server:
# DATABASE_URL=postgres://studio:change-me@localhost:5432/studio
DATABASE_URL=
PGLITE_DATA_DIR=

# --- Background worker --------------------------------------------------
# "embedded" runs jobs inside the API process; "off" requires a separate worker (PostgreSQL only).
WORKER_MODE=embedded
WORKER_CONCURRENCY=2
WORKER_POLL_MS=500

# --- AI text provider (story, plan, listing): Anthropic Claude ----------
# Without a key the studio uses a clearly labelled demo template writer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
TEXT_TIMEOUT_MS=180000
# USD per million tokens, used for usage/cost records (set from your price list).
TEXT_INPUT_COST_PER_MTOK=4
TEXT_OUTPUT_COST_PER_MTOK=20
# --- AI text provider alternative: Groq (free tier, text only) -----------
# Used when ANTHROPIC_API_KEY is empty and GROQ_API_KEY is set. Create a key at console.groq.com.
GROQ_API_KEY=
# Any Groq chat model that supports JSON mode; check console.groq.com/docs/models for current IDs.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Free-tier requests have small per-minute token limits; keep this at or below your model's cap.
GROQ_MAX_TOKENS=8000

# auto | anthropic | groq | demo
TEXT_PROVIDER=auto

# --- AI image provider (pages, cover art, character references): OpenAI --
# Without a key the studio draws placeholder art stamped "DEMO". It is never presented as AI output.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_TIMEOUT_MS=180000
# Estimated USD per image at each quality level; used for batch estimates. Check your provider's pricing.
IMAGE_COST_DRAFT_USD=0.011
IMAGE_COST_STANDARD_USD=0.042
IMAGE_COST_HIGH_USD=0.167
# auto | openai | demo
IMAGE_PROVIDER=auto
# Demo renderer size multiplier (0.1-1).
DEMO_IMAGE_SCALE=0.5

# --- Limits & cost control ----------------------------------------------
MONTHLY_IMAGE_QUOTA=400
MONTHLY_TEXT_QUOTA=200
# Batches estimated above this cost, or with more images than this, need confirmation.
BATCH_CONFIRM_USD=2
BATCH_CONFIRM_IMAGES=40
MAX_UPLOAD_MB=20
MAX_PROJECTS_PER_USER=200
